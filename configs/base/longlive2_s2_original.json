      "backing_ram_gib": 4.0,
      "backing_disk_gib": 18.0,
      "working_ram_mib": 512,
      "working_vram_mib": 512,
      "staging_mib": 16,
      "system_ram_reserve_gib": 0.0,
      "process_rss_limit_gib": null,
