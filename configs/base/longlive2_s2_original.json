    "model_config": "checkpoints/Wan2.2-TI2V-5B/config.json",
    "chunk": 8,
    "vae_stride": 16,
    "sampler": "unipc",
    "steps": 2,
    "shift": 5.0,
    "context_frames": 32,
    "sink_frames": 8,
    "positions": "video",
    "pc_recent": null,
    "cross_cache": true,
    "context_noise": 0,
    "attention": "cudnn",
    "compile": "default",
    "multi_shot_rope_offset": 8,
