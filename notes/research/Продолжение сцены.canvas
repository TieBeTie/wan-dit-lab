		{"id":"history-policy-recache","fromNode":"history-policy","toNode":"recache","fromSide":"bottom","toSide":"top","fromEnd":"none","toEnd":"arrow","label":"пересчитать"},
		{"id":"history-policy-decay","fromNode":"history-policy","toNode":"decay","fromSide":"right","toSide":"right","fromEnd":"none","toEnd":"arrow","label":"ослабить"},
